{
  "sweep_id": "seg_scale",
  "what": "The same scaling sweep on a different workload: KNet-Swin-L segmentation, batch 2 per card. An independent second look at the two questions det_scale raises.",
  "provenance": {
    "hardware": "the same eight-card node as det_scale",
    "topology_note": "Same sockets and same half-populated channels. The 4-card cells are again {0,1,2,3} same-socket and {0,1,4,5} cross-socket.",
    "cpu_governor": "performance",
    "workload": "KNet-Swin-L, mmsegmentation, --amp, DDP, batch 2 per card",
    "window": "360 s of steady state per cell, first 25% of logged steps discarded",
    "repeats": 1,
    "why_it_matters": "This sweep shares the node and the harness with det_scale but not the model, the batch size, the memory footprint or the collective volume. Anything that shows up in both is not a property of one model."
