{
  "sweep_id": "det_scale",
  "what": "Multi-card scaling sweep for the same detection training run, all cells at the tuned single-card configuration (batch 24 / workers 32 / pin True).",
  "provenance": {
    "hardware": "eight NVIDIA GeForce RTX 5090, 32607 MiB each, two sockets",
    "topology_note": "Cards 0-3 sit on one socket and 4-7 on the other. Each socket's memory channels are half-populated: half the channels carry a module, half are empty. The 4-card cells are the same-socket set {0,1,2,3} and the cross-socket set {0,1,4,5}.",
    "cpu_governor": "performance",
    "workload": "YOLOX-L, mmdetection, --amp, DDP",
    "window": "240 s of steady state per cell, first 25% of logged steps discarded",
    "repeats": 1
  },
  "strata": [
    "ngpu"
  ],
  "strata_note": "Total throughput across a different number of cards is not a choice between two configurations at the same scale, so pairwise ranking questions are asked only within a card count. The four-card stratum is the one with two cells in it.",
  "metrics": {
    "throughput_img_s": {
      "role": "objective",
      "higher_is_better": true,
      "unit": "img/s"
    },
    "sm_util_mean_pct": {
      "role": "proxy",
      "higher_is_better": true,
      "unit": "%"
    },
    "sm_zero_frac_pct": {
      "role": "diagnostic",
      "higher_is_better": false,
      "unit": "%",
      "note": "Fraction of dmon samples reading SM = 0 on a participating card. The only diagnostic here that moves with card count."
    },
    "power_mean_w": {
      "role": "cost",
      "higher_is_better": false,
      "unit": "W"
    },
    "step_time_s": {
      "role": "diagnostic",
      "higher_is_better": false,
      "unit": "s"
    }
  },
  "derived": [
    {
      "name": "speedup",
      "formula": "ratio_to_baseline",
      "of": "throughput_img_s",
      "note": "As reported in the summary table this column was built against two different baselines. The per-row baselines below are what the numbers in `reported` were actually divided by -- transcribed, not guessed. `sweeprank derived` refuses the column for that reason.",
      "baselines": {
        "det_tune:det_1gpu": [
          "single_bs8",
          "single_bs24nw8",
          "single_bs24nw32",
          "single_bs24nw32pin"
        ],
        "det_opt_1gpu": [
          "det_opt_2gpu",
          "det_opt_4gpu",
          "det_opt_4gpuX",
          "det_opt_8gpu"
        ]
      },
      "reported": {
        "single_bs8": 1.0,
        "single_bs24nw8": 1.17,
        "single_bs24nw32": 1.18,
        "single_bs24nw32pin": 1.18,
        "det_opt_2gpu": 1.98,
        "det_opt_4gpu": 3.72,
        "det_opt_4gpuX": 3.91,
        "det_opt_8gpu": 6.13
      }
    },
    {
      "name": "efficiency",
      "formula": "speedup_over_units",
      "of": "speedup",
      "units_knob": "ngpu",
      "note": "speedup / ngpu. On the single-card rows ngpu is 1, so this column reprints a batch-size speedup under the name 'scaling efficiency' and prints values above 100%.",
      "reported": {
        "single_bs8": 100.0,
        "single_bs24nw8": 117.0,
        "single_bs24nw32": 118.3,
        "single_bs24nw32pin": 118.4,
        "det_opt_2gpu": 98.9,
        "det_opt_4gpu": 93.1,
        "det_opt_4gpuX": 97.9,
        "det_opt_8gpu": 76.6
      }
    }
  ],
